---
import { Check, ChevronDown, Languages as LanguagesIcon } from "lucide-react";

import { languages, languageCodes } from "@/i18n/languages";
import { getLangFromUrl, switchLocalePath, useTranslations } from "@/i18n";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const activeLanguage = languages[currentLang];

const items = languageCodes.map((code) => ({
  code,
  meta: languages[code],
  href: switchLocalePath(Astro.url.pathname, code),
  active: code === currentLang,
}));

const senyeraStripes = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---

<details class="language-menu group relative z-40" data-language-menu>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-2 border border-foreground/25 bg-background/85 px-3 text-xs font-extrabold uppercase tracking-[0.1em] shadow-sm backdrop-blur transition-colors hover:border-foreground hover:bg-foreground hover:text-background [&::-webkit-details-marker]:hidden"
    aria-label={t.langSwitcher.label}
  >
    <LanguagesIcon className="size-4" aria-hidden="true" />
    <span>{activeLanguage.label}</span>
    <ChevronDown
      className="size-3.5 transition-transform"
      data-language-chevron
      aria-hidden="true"
    />
  </summary>

  <div
    class="absolute right-0 top-full mt-2 w-[min(18rem,calc(100vw-2rem))] border border-foreground bg-popover p-2 text-popover-foreground shadow-[0.4rem_0.4rem_0_var(--foreground)] rtl:left-0 rtl:right-auto"
  >
    <p class="px-3 pb-2 pt-1 text-[0.65rem] font-extrabold uppercase tracking-[0.16em] text-muted-foreground">
      {t.langSwitcher.label}
    </p>
    <nav class="grid grid-cols-2 gap-1" aria-label={t.langSwitcher.label}>
      {
        items.map(({ code, meta, href, active }) => (
          <a
            href={href}
            hreflang={code}
            lang={code}
            aria-label={`${meta.englishName}${active ? ` (${t.langSwitcher.current})` : ""}`}
            aria-current={active ? "true" : undefined}
            class:list={[
              "flex min-h-11 items-center gap-2 px-3 py-2 text-sm font-bold transition-colors",
              active
                ? "bg-primary text-primary-foreground"
                : "hover:bg-accent hover:text-accent-foreground",
            ]}
          >
            <span class="grid w-5 place-items-center text-base leading-none" aria-hidden="true">
              {meta.flag ?? (
                <svg viewBox="0 0 27 18" width="19" height="13" class="block" aria-hidden="true">
                  <rect width="27" height="18" fill="#FCDD09" />
                  {senyeraStripes
                    .filter((i) => i % 2 === 1)
                    .map((i) => <rect y={i * 2} width="27" height="2" fill="#DA121A" />)}
                </svg>
              )}
            </span>
            <span class="min-w-0 flex-1 truncate">{meta.label}</span>
            {active && <Check className="size-3.5 shrink-0" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>
  </div>
</details>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-language-menu]").forEach((menu) => {
      document.addEventListener("click", (event) => {
        if (menu.hasAttribute("open") && !menu.contains(event.target)) {
          menu.removeAttribute("open");
        }
      });

      menu.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          menu.removeAttribute("open");
          menu.querySelector("summary")?.focus();
        }
      });
    });
  })();
</script>
