---
import { navLinks, site } from "@/data/site";
---

<footer class="border-t bg-foreground text-background">
  <div class="container-page grid gap-8 py-10 md:grid-cols-[auto_1fr_auto] md:items-start">
    <img src={site.logo} alt={site.logoAlt} class="w-36 rounded-md bg-background object-contain p-2" loading="lazy" decoding="async" />
    <div class="max-w-2xl">
      <p class="text-lg font-semibold">{site.name}</p>
      <p class="mt-3 text-sm leading-6 text-background/75">{site.description}</p>
      <a href={site.url} class="mt-4 inline-block text-sm font-medium text-background/80 hover:text-background">
        {site.url.replace("https://", "")}
      </a>
    </div>

    <nav class="flex flex-col gap-2 text-sm" aria-label="Footer navigation">
      {navLinks.map((link) => <a href={link.href} class="text-background/75 hover:text-background">{link.label}</a>)}
    </nav>
  </div>
</footer>
