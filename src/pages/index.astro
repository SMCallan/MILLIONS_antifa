---
import { ArrowRight, CalendarDays, MapPin, Upload, UsersRound } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { bookingFeatures, site, tourDates } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const featuredDates = tourDates.slice(0, 3);
---

<Layout title={site.name} description={site.description}>
  <SignalFieldHero client:load />

  <section id="projects" class="section-y bg-background">
    <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <Badge variant="secondary">Biography and purpose</Badge>
        <h2 class="mt-5 max-w-xl text-4xl font-black leading-tight md:text-5xl">
          An exhibition built for public memory and local organising.
        </h2>
      </div>

      <div class="grid gap-6 text-base leading-8 text-muted-foreground">
        <p>
          The Anti-Fascist Art Exhibition presents contemporary artworks alongside archival
          fragments, oral histories, printed matter, and community documentation. It is designed to
          travel between cultural venues, libraries, colleges, unions, and civic spaces.
        </p>
        <p>
          The exhibition centres artists and organisers whose work preserves the memory of
          anti-fascist resistance while making space for audiences to consider how culture, care,
          and collective action can interrupt authoritarian movements now.
        </p>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="border-l-4 border-primary pl-4">
            <p class="text-2xl font-black text-foreground">40+</p>
            <p class="text-sm">works and archive items</p>
          </div>
          <div class="border-l-4 border-secondary pl-4">
            <p class="text-2xl font-black text-foreground">3</p>
            <p class="text-sm">touring formats</p>
          </div>
          <div class="border-l-4 border-accent pl-4">
            <p class="text-2xl font-black text-foreground">2026</p>
            <p class="text-sm">open call route</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y bg-muted/55">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <Badge>Tour route</Badge>
          <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">Upcoming exhibition dates</h2>
        </div>
        <a class={buttonVariants({ variant: "outline" })} href="/tour-dates">
          View all dates
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          featuredDates.map((event) => (
            <Card>
              <CardHeader>
                <CardDescription className="flex items-center gap-2">
                  <CalendarDays className="size-4" aria-hidden="true" />
                  {event.date}
                </CardDescription>
                <CardTitle className="text-2xl">{event.city}</CardTitle>
              </CardHeader>
              <CardContent className="grid gap-4">
                <p class="flex items-center gap-2 text-sm text-muted-foreground">
                  <MapPin className="size-4" aria-hidden="true" />
                  {event.venue}
                </p>
                <div class="flex flex-wrap gap-2">
                  <Badge variant={event.status === "Confirmed" ? "default" : "outline"}>{event.status}</Badge>
                  <Badge variant="secondary">{event.format}</Badge>
                </div>
              </CardContent>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-y bg-background">
    <div class="container-page grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <Badge variant="outline">Host the exhibition</Badge>
        <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">
          Bring the exhibition to your centre, school, venue, or local group.
        </h2>
        <p class="mt-5 max-w-xl text-muted-foreground leading-7">
          The touring format can be scaled to suit different rooms, audiences, staffing capacity,
          and public programmes.
        </p>
      </div>

      <div class="grid gap-4">
        {
          bookingFeatures.map((feature, index) => {
            const Icon = [UsersRound, Upload, CalendarDays][index] ?? UsersRound;
            return (
              <div class="flex gap-4 border-b pb-5 last:border-b-0">
                <span class="grid size-10 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground">
                  <Icon className="size-5" aria-hidden="true" />
                </span>
                <p class="leading-7 text-muted-foreground">{feature}</p>
              </div>
            );
          })
        }

        <div class="mt-3 flex flex-wrap gap-3">
          <a class={buttonVariants({ size: "lg" })} href="/booking">
            Make a booking enquiry
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a class={buttonVariants({ size: "lg", variant: "secondary" })} href="/submit">
            Submit artwork
            <Upload className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
