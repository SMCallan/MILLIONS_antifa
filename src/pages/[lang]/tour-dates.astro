---
import TourDatesBody from "@/components/pages/TourDates.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getLocalePaths, useTranslations } from "@/i18n";

export const getStaticPaths = getLocalePaths;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.nav.tourDates} description={t.tourDates.heroSubtitle}>
  <TourDatesBody />
</Layout>
