---
import { Check } from "lucide-react";

import ContactReveal from "@/components/ContactReveal.astro";
import { SignalFieldHero } from "@/components/SignalFieldHero";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.host.heroTitle}
  subtitle={t.host.heroSubtitle}
  primaryCta={{ label: t.nav.tourDates, href: localizePath("/tour-dates", lang) }}
  secondaryCta={{ label: t.nav.contribute, href: localizePath("/contribute", lang) }}
/>

<section class="section-y bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-16">
    <div>
      <h2 class="text-2xl font-black md:text-3xl">{t.host.proposalTitle}</h2>
      <ul class="mt-6 grid gap-3">
        {
          t.host.proposalItems.map((item) => (
            <li class="flex gap-3 text-base leading-7 text-muted-foreground">
              <Check className="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <ContactReveal title={t.host.revealTitle} />
  </div>
</section>

