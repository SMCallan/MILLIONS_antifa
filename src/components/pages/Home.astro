---
import { ArrowRight, CalendarDays, MapPin, Upload } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { artistCommissions, tourDates } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const statusLabel = (status: string) => t.tourDates.status[status] ?? status;
const featuredDates = tourDates.filter((event) => event.status !== "Break").slice(0, 3);
---

<SignalFieldHero
  client:load
  layout="split"
  logo="/million-words-logo.png"
  logoAlt={t.meta.siteName}
  logoCaption={t.hero.logoCaption}
  headline={t.hero.title}
  subtitle={t.hero.subtitle}
  badges={t.hero.badges}
  statusLines={t.hero.statusLines}
  primaryCta={{ label: t.hero.primaryCta, href: localizePath("/tour-dates", lang) }}
  secondaryCta={{ label: t.hero.secondaryCta, href: localizePath("/contribute", lang) }}
/>

<section id="concept" class="section-y bg-background">
  <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div>
      <Badge variant="secondary">{t.home.conceptBadge}</Badge>
      <h2 class="mt-5 max-w-xl text-4xl font-black leading-tight md:text-5xl">
        {t.home.conceptTitle}
      </h2>
      <img
        src="/million-words-logo.png"
        alt={t.meta.siteName}
        class="mt-8 w-full max-w-sm rounded-md border bg-white object-contain p-2 shadow-sm"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="grid gap-6 text-base leading-8 text-muted-foreground">
      {t.home.conceptBody.map((paragraph) => <p>{paragraph}</p>)}
      <div class="grid gap-3 sm:grid-cols-3">
        {
          t.home.stats.map((stat, index) => (
            <div
              class:list={[
                "border-l-4 pl-4",
                ["border-primary", "border-secondary", "border-accent"][index] ?? "border-primary",
              ]}
            >
              <p class="text-2xl font-black text-foreground">{stat.value}</p>
              <p class="text-sm">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section-y bg-muted/55">
  <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
    <div>
      <Badge>{t.home.installationBadge}</Badge>
      <h2 class="mt-4 max-w-xl text-3xl font-black leading-tight md:text-5xl">
        {t.home.installationTitle}
      </h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground">
        {t.home.installationBody}
      </p>
    </div>

    <div class="grid gap-4">
      <h3 class="text-xl font-black">{t.home.commissionsTitle}</h3>
      <p class="text-sm leading-7 text-muted-foreground">{t.home.commissionsBody}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          artistCommissions.map((artist) => (
            <p class="rounded-md border bg-background px-4 py-3 text-sm font-medium">{artist}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="section-y bg-background">
  <div class="container-page">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <Badge>{t.home.tourBadge}</Badge>
        <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">{t.home.tourTitle}</h2>
        <p class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">{t.home.tourBody}</p>
      </div>
      <a class={buttonVariants({ variant: "outline" })} href={localizePath("/tour-dates", lang)}>
        {t.common.viewAllDates}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        featuredDates.map((event) => (
          <Card>
            <CardHeader>
              <CardDescription className="flex items-center gap-2">
                <CalendarDays className="size-4" aria-hidden="true" />
                {event.date}
              </CardDescription>
              <CardTitle className="text-2xl">{event.city}</CardTitle>
            </CardHeader>
            <CardContent className="grid gap-4">
              <p class="flex items-center gap-2 text-sm text-muted-foreground">
                <MapPin className="size-4" aria-hidden="true" />
                {event.venue}
              </p>
              <div class="flex flex-wrap gap-2">
                <Badge variant={event.status === "Booked" ? "default" : "outline"}>{statusLabel(event.status)}</Badge>
                <Badge variant="secondary">{event.format}</Badge>
              </div>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<section class="section-y bg-muted/55">
  <div class="container-page grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
    <div>
      <Badge variant="outline">{t.home.hostBadge}</Badge>
      <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">{t.home.hostTitle}</h2>
      <p class="mt-5 max-w-xl leading-7 text-muted-foreground">{t.home.hostBody}</p>
    </div>

    <div class="flex flex-col justify-center gap-4">
      <div class="flex flex-wrap gap-3">
        <a class={buttonVariants({ size: "lg" })} href={localizePath("/host", lang)}>
          {t.home.hostCta}
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
        <a class={buttonVariants({ size: "lg", variant: "secondary" })} href={localizePath("/contribute", lang)}>
          {t.home.contributeCta}
          <Upload className="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
