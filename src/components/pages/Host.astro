---
import { Check, Mail } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import TurnstileWidget from "@/components/TurnstileWidget.astro";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.host.heroTitle}
  subtitle={t.host.heroSubtitle}
  primaryCta={{ label: t.nav.tourDates, href: localizePath("/tour-dates", lang) }}
  secondaryCta={{ label: t.nav.contribute, href: localizePath("/contribute", lang) }}
/>

<section class="section-y bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-16">
    <div>
      <h2 class="text-2xl font-black md:text-3xl">{t.host.proposalTitle}</h2>
      <ul class="mt-6 grid gap-3">
        {
          t.host.proposalItems.map((item) => (
            <li class="flex gap-3 text-base leading-7 text-muted-foreground">
              <Check className="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      The address is not in this page's markup. It is fetched from
      /api/contact-email only after Turnstile verifies server-side, so
      address-harvesting crawlers reading the HTML find nothing.
    -->
    <div class="border-2 border-foreground bg-card p-6 print-shadow">
      <h2 class="flex items-center gap-2 text-xl font-black">
        <Mail className="size-5 text-primary" aria-hidden="true" />
        {t.host.revealTitle}
      </h2>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">{t.host.revealBody}</p>

      <form
        data-contact-reveal
        data-pending={t.host.revealPending}
        data-failed={t.host.revealError}
        class="mt-5 grid gap-4">
        <TurnstileWidget />
        <button
          type="submit"
          class="inline-flex min-h-12 cursor-pointer items-center justify-center gap-2 border border-primary bg-primary px-5 text-sm font-black uppercase tracking-[0.13em] text-primary-foreground transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-60"
        >
          {t.host.revealButton}
        </button>
      </form>

      <p data-contact-status role="status" aria-live="polite" class="mt-4 text-sm leading-6"></p>
      <p data-contact-result hidden class="mt-2 break-words text-lg font-black"></p>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-contact-reveal]");
    const status = document.querySelector("[data-contact-status]");
    const result = document.querySelector("[data-contact-result]");
    if (!form || !status || !result) return;

    const button = form.querySelector("button[type=submit]");
    const pending = form.dataset.pending || "";
    const failed = form.dataset.failed || "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.textContent = pending;
      if (button) button.disabled = true;

      try {
        const response = await fetch("/api/contact-email", {
          method: "POST",
          body: new FormData(form),
        });
        const data = await response.json();

        if (!response.ok || !data.ok || !data.email) {
          throw new Error(data.error || "failed");
        }

        status.textContent = "";
        form.hidden = true;
        result.hidden = false;
        // Built at runtime so the address never appears in the served HTML.
        const link = document.createElement("a");
        link.href = "mailto:" + data.email;
        link.textContent = data.email;
        link.className = "text-primary underline underline-offset-4";
        result.replaceChildren(link);
      } catch {
        status.textContent = failed;
        if (button) button.disabled = false;
        if (window.turnstile) window.turnstile.reset();
      }
    });
  })();
</script>
