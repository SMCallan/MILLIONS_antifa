---
import ContributeBody from "@/components/pages/Contribute.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getLocalePaths, useTranslations } from "@/i18n";

export const getStaticPaths = getLocalePaths;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.nav.contribute} description={t.contribute.heroSubtitle}>
  <ContributeBody />
</Layout>
