    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADRFT7L2bMh6kj8a"
  },

  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "millions-antifa-submissions",
