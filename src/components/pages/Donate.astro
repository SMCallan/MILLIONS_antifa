---
import { Heart, HandCoins, Mail } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { site } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.donate.heroTitle}
  subtitle={t.donate.heroSubtitle}
  primaryCta={{ label: t.nav.donate, href: "#donate" }}
  secondaryCta={{ label: t.hero.primaryCta, href: localizePath("/tour-dates", lang) }}
  badges={t.hero.badges}
  statusLines={t.hero.statusLines}
/>

<section class="section-y bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
    <div>
      <Badge variant="secondary">{t.nav.donate}</Badge>
      <h2 class="mt-4 text-3xl font-black leading-tight md:text-4xl">{t.donate.introTitle}</h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground">{t.donate.introBody}</p>

      <h3 class="mt-10 text-xl font-black">{t.donate.usesTitle}</h3>
      <ul class="mt-4 grid gap-3">
        {
          t.donate.uses.map((use) => (
            <li class="flex gap-3 border-b pb-3 last:border-b-0">
              <Heart className="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
              <span class="text-sm leading-7 text-muted-foreground">{use}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside id="donate" class="lg:sticky lg:top-28">
      <Card>
        <CardHeader>
          <CardTitle className="flex items-center gap-2 text-2xl">
            <HandCoins className="size-6 text-primary" aria-hidden="true" />
            {t.donate.ctaTitle}
          </CardTitle>
        </CardHeader>
        <CardContent className="grid gap-5">
          <p class="text-sm leading-7 text-muted-foreground">{t.donate.ctaBody}</p>
          <div class="rounded-md border border-dashed border-accent bg-accent/15 p-4 text-sm font-medium text-accent-foreground">
            {t.donate.ctaPending}
          </div>
          <a class={buttonVariants({ size: "lg", className: "w-full" })} href={`mailto:${site.email}`}>
            <Mail className="size-4" aria-hidden="true" />
            {t.donate.ctaButton}
          </a>
          <p class="text-xs text-muted-foreground">{t.common.draftNotice}</p>
        </CardContent>
      </Card>
    </aside>
  </div>
</section>
