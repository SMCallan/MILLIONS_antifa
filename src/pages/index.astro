---
import { ArrowRight, CalendarDays, MapPin, Upload, UsersRound } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { artistCommissions, bookingFeatures, site, tourDates } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const featuredDates = tourDates.filter((event) => event.status !== "Break").slice(0, 3);
---

<Layout title={site.name} description={site.description}>
  <SignalFieldHero client:load />

  <section id="projects" class="section-y bg-background">
    <div class="container-page grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <Badge variant="secondary">Concept and purpose</Badge>
        <h2 class="mt-5 max-w-xl text-4xl font-black leading-tight md:text-5xl">
          A thousand young artists. A million words against fascism.
        </h2>
        <img
          src={site.logo}
          alt={site.logoAlt}
          class="mt-8 w-full max-w-sm rounded-md border bg-white object-contain p-2 shadow-sm"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="grid gap-6 text-base leading-8 text-muted-foreground">
        <p>
          If a picture tells a thousand words, a thousand artists create a million words. The
          exhibition brings those voices together as an international response to the rise of
          far-right and fascist ideologies.
        </p>
        <p>
          By June 2026, the Solidarity Park Project will have facilitated more than 1,000 visual
          artworks by young people through its porthole education initiative about the Spanish Civil
          War, the International Brigades, and the lessons of international solidarity.
        </p>
        <p>
          The 2027 tour builds toward the 90th anniversary of the sinking of the Ciudad de Barcelona
          on 30 May 2027, the story that helped launch Association Solidarity Park's work in art,
          memory, and education.
        </p>
        <div class="grid gap-3 sm:grid-cols-3">
          <div class="border-l-4 border-primary pl-4">
            <p class="text-2xl font-black text-foreground">1,000+</p>
            <p class="text-sm">young artists' works</p>
          </div>
          <div class="border-l-4 border-secondary pl-4">
            <p class="text-2xl font-black text-foreground">4 x 4m</p>
            <p class="text-sm">Solidarity Room plan</p>
          </div>
          <div class="border-l-4 border-accent pl-4">
            <p class="text-2xl font-black text-foreground">2027</p>
            <p class="text-sm">anniversary tour</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y bg-muted/55">
    <div class="container-page grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
      <div>
        <Badge>Installation</Badge>
        <h2 class="mt-4 max-w-xl text-3xl font-black leading-tight md:text-5xl">
          The Solidarity Room sits at the centre of the exhibition.
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground">
          Inside, the room is planned as a wall-to-wall display of 1,000 postcard-sized images made
          through the Solidarity Park project. Outside, the street-facing walls can gather another
          1,000 new images created by visitors, schools, colleges, and community participants during
          the tour.
        </p>
      </div>

      <div class="grid gap-4">
        <h3 class="text-xl font-black">International artist commissions</h3>
        <p class="text-sm leading-7 text-muted-foreground">
          Surrounding the Solidarity Room will be a curated programme inspired by millions of
          stories against fascism, including film, animation, sculpture, painting, illustration, and
          poetry.
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            artistCommissions.map((artist) => (
              <p class="rounded-md border bg-background px-4 py-3 text-sm font-medium">{artist}</p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-y bg-background">
    <div class="container-page">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <Badge>Tour route</Badge>
          <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">International tour dates</h2>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-muted-foreground">
            Dates and collaborators are subject to final agreements and confirmations.
          </p>
        </div>
        <a class={buttonVariants({ variant: "outline" })} href="/tour-dates">
          View all dates
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {
          featuredDates.map((event) => (
            <Card>
              <CardHeader>
                <CardDescription className="flex items-center gap-2">
                  <CalendarDays className="size-4" aria-hidden="true" />
                  {event.date}
                </CardDescription>
                <CardTitle className="text-2xl">{event.city}</CardTitle>
              </CardHeader>
              <CardContent className="grid gap-4">
                <p class="flex items-center gap-2 text-sm text-muted-foreground">
                  <MapPin className="size-4" aria-hidden="true" />
                  {event.venue}
                </p>
                <div class="flex flex-wrap gap-2">
                  <Badge variant={event.status === "Booked" ? "default" : "outline"}>{event.status}</Badge>
                  <Badge variant="secondary">{event.format}</Badge>
                </div>
              </CardContent>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-y bg-muted/55">
    <div class="container-page grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <Badge variant="outline">Host the exhibition</Badge>
        <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">
          Bring the tour to a school, union, venue, festival, or civic space.
        </h2>
        <p class="mt-5 max-w-xl text-muted-foreground leading-7">
          Each event can combine the core installation with local International Brigades history,
          workshops, live music, poetry, and local anti-fascist artists where space allows.
        </p>
      </div>

      <div class="grid gap-4">
        {
          bookingFeatures.map((feature, index) => {
            const Icon = [UsersRound, Upload, CalendarDays][index] ?? UsersRound;
            return (
              <div class="flex gap-4 border-b pb-5 last:border-b-0">
                <span class="grid size-10 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground">
                  <Icon className="size-5" aria-hidden="true" />
                </span>
                <p class="leading-7 text-muted-foreground">{feature}</p>
              </div>
            );
          })
        }

        <div class="mt-3 flex flex-wrap gap-3">
          <a class={buttonVariants({ size: "lg" })} href="/booking">
            Make a booking enquiry
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a class={buttonVariants({ size: "lg", variant: "secondary" })} href="/submit">
            Contribute artwork
            <Upload className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
