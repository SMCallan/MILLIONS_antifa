---
import { Mail } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import TurnstileWidget from "@/components/TurnstileWidget.astro";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { submissionGuidelines } from "@/data/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contribute Artwork"
  description="Request a secure contribution link for artwork, poetry, moving image, or local anti-fascist material for A Million Words Against Fascism."
>
  <SignalFieldHero
    client:load
    compact
    headline="Contribute artwork, poetry, or local material."
    subtitle="Where venues have space, the tour can include local anti-fascist artists, poets, film-makers, animators, sculptors, painters, and community contributors alongside the core exhibition."
    primaryCta={{ label: "Request link", href: "#artwork-form" }}
    secondaryCta={{ label: "Tour dates", href: "/tour-dates" }}
    badges={["Local artists", "Anti-fascist poetry", "Film and animation", "Preview files", "Community material"]}
    statusLines={[
      "Preview files and links only through the public flow",
      "Selected contributors may be contacted later for production-ready originals",
    ]}
  />

  <section id="artwork-form" class="section-y bg-background">
    <div class="container-page grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <aside class="space-y-5">
        <h2 class="text-2xl font-black">Contribution notes</h2>
        <div class="grid gap-4">
          {
            submissionGuidelines.map((item) => (
              <p class="border-l-4 border-primary pl-4 text-sm leading-7 text-muted-foreground">{item}</p>
            ))
          }
        </div>
      </aside>

      <Card>
        <CardHeader>
          <CardTitle className="text-2xl">Request a secure contribution link</CardTitle>
          <CardDescription>
            Enter the email address you want attached to the contribution. The link lets you create
            or update one active preview contribution for the tour.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div data-form-status="link-sent" hidden class="mb-6 rounded-md border border-secondary bg-secondary/35 p-4 text-sm font-medium text-secondary-foreground" role="status">
            If the address can receive contribution links, a secure link has been sent. Check your inbox and spam folder.
          </div>
          <div data-form-status="invalid-email" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please enter a valid email address.
          </div>
          <div data-form-status="database-unconfigured" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Contribution storage is not configured yet.
          </div>
          <div data-form-status="magic-link-unconfigured" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Secure contribution links are not configured yet.
          </div>
          <div data-form-status="verified-link-required" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Artwork contributions now require a secure email link.
          </div>
          <div data-form-status="turnstile-missing" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please complete the verification challenge before requesting a link.
          </div>
          <div data-form-status="turnstile-invalid" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification failed. Please complete the challenge and try again.
          </div>
          <div data-form-status="turnstile-unconfigured" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification is not configured for this environment.
          </div>
          <div data-form-status="turnstile-unavailable" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification could not be completed. Please try again.
          </div>

          <script is:inline>
            const params = new URLSearchParams(window.location.search);
            const status = params.get("link") === "sent" ? "link-sent" : params.get("error");

            if (status && /^[a-z-]+$/.test(status)) {
              document.querySelector(`[data-form-status="${status}"]`)?.removeAttribute("hidden");
            }
          </script>

          <form action="/api/submission/request-link" method="post" class="grid gap-6">
            <div class="grid gap-2">
              <Label htmlFor="email">Email *</Label>
              <Input id="email" name="email" type="email" required autoComplete="email" maxLength={254} />
            </div>

            <TurnstileWidget />

            <Button type="submit" size="lg" className="w-full sm:w-fit">
              <Mail aria-hidden="true" />
              Send secure contribution link
            </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>
