---
import { ArrowRight } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.concept.heroTitle}
  subtitle={t.concept.heroSubtitle}
  showCtas={false}
/>

<section class="section-y bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
    <div class="lg:sticky lg:top-28">
      <Badge variant="secondary">{t.nav.concept}</Badge>
      <img
        src="/million-words-logo.webp"
        alt={t.meta.siteName}
        class="mt-5 w-full max-w-xs rounded-md border bg-white object-contain p-2 shadow-sm"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="grid gap-8">
      {
        t.concept.sections.map((section, index) => (
          <article class="border-l-4 border-primary pl-5">
            <h3 class="text-xl font-black md:text-2xl">
              <span class="mr-2 text-muted-foreground">{String(index + 1).padStart(2, "0")}</span>
              {section.heading}
            </h3>
            <p class="mt-3 text-base leading-8 text-muted-foreground">{section.body}</p>
          </article>
        ))
      }

      <div class="flex flex-wrap gap-3 pt-2">
        <a class={buttonVariants({ size: "lg" })} href={localizePath("/tour-dates", lang)}>
          {t.hero.primaryCta}
          <ArrowRight className="size-4" aria-hidden="true" />
        </a>
        <a class={buttonVariants({ size: "lg", variant: "outline" })} href={localizePath("/contribute", lang)}>
          {t.nav.contribute}
        </a>
      </div>
    </div>
  </div>
</section>
