---
import { languages, languageCodes } from "@/i18n/languages";
import { getLangFromUrl, switchLocalePath, useTranslations } from "@/i18n";

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Build the equivalent path in each locale so switching keeps the visitor on
// the same page. Computed at build time from the current route.
const items = languageCodes.map((code) => ({
  code,
  meta: languages[code],
  href: switchLocalePath(Astro.url.pathname, code),
  active: code === currentLang,
}));

// Catalan has no flag emoji — render the senyera as inline SVG.
const senyeraStripes = [0, 1, 2, 3, 4, 5, 6, 7, 8];
---

<nav class="flex flex-wrap items-center gap-1.5" aria-label={t.langSwitcher.label}>
  {
    items.map(({ code, meta, href, active }) => (
      <a
        href={href}
        hreflang={code}
        lang={code}
        aria-label={`${meta.englishName}${active ? ` (${t.langSwitcher.current})` : ""}`}
        aria-current={active ? "true" : undefined}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-md border px-2 py-1 text-xs font-medium leading-none transition-colors",
          active
            ? "border-primary bg-primary/10 text-foreground"
            : "border-border/70 text-muted-foreground hover:border-border hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        <span class="text-sm leading-none" aria-hidden="true">
          {meta.flag ?? (
            <svg
              viewBox="0 0 27 18"
              width="18"
              height="12"
              class="block rounded-[1px]"
              role="img"
              aria-hidden="true"
            >
              <rect width="27" height="18" fill="#FCDD09" />
              {senyeraStripes
                .filter((i) => i % 2 === 1)
                .map((i) => (
                  <rect y={i * 2} width="27" height="2" fill="#DA121A" />
                ))}
            </svg>
          )}
        </span>
        <span class="hidden sm:inline">{meta.label}</span>
      </a>
    ))
  }
</nav>
