---
import { ArrowRight, ArrowUpRight, Menu, X } from "lucide-react";

import { HomeAnimation } from "@/components/HomeAnimation";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { footerNav } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navLabel = (key: string) => (t.nav as Record<string, string>)[key] ?? key;
const needsCompactHero = (["de", "sv", "nl"] as const).includes(lang as "de" | "sv" | "nl");
const brandName = "Solidarity Park";
const brandNameIndex = t.hero.subtitle.indexOf(brandName);
const heroCopy = brandNameIndex >= 0
  ? {
      before: t.hero.subtitle.slice(0, brandNameIndex),
      brand: brandName,
      after: t.hero.subtitle.slice(brandNameIndex + brandName.length),
    }
  : { before: t.hero.subtitle, brand: "", after: "" };
---

<div class="paper-surface relative flex h-dvh flex-col overflow-hidden bg-background text-foreground">
  <div class="solidarity-rail absolute inset-y-0 left-0 hidden w-2 sm:block" aria-hidden="true"></div>

  <header class="relative z-20 flex min-h-[4.5rem] items-center justify-between gap-4 border-b border-foreground/20 px-4 sm:px-7 lg:px-10">
    <a href={localizePath("/", lang)} class="group flex items-center gap-3" aria-label={t.meta.siteName}>
      <span class="grid size-12 shrink-0 place-items-center overflow-hidden border border-foreground/30 bg-white shadow-sm transition-transform group-hover:-rotate-2 sm:size-13">
        <img
          src="/million-words-logo-icon.webp"
          alt=""
          class="h-full w-full object-cover"
          width="104"
          height="104"
          loading="eager"
          decoding="async"
        />
      </span>
      <span class="hidden sm:block">
        <span class="display-type block max-w-40 text-sm uppercase leading-none">{t.meta.siteName}</span>
      </span>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <LanguageSwitcher />
      <button
        type="button"
        data-menu-open
        aria-label={t.nav.menu}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="site-menu"
        class="flex min-h-11 cursor-pointer items-center gap-2 border border-foreground bg-foreground px-3 text-xs font-extrabold uppercase tracking-[0.12em] text-background transition-colors hover:bg-primary sm:px-4"
      >
        <Menu className="size-4" aria-hidden="true" />
        <span class="hidden min-[400px]:inline">{t.nav.menu}</span>
      </button>
    </div>
  </header>

  <main
    id="main-content"
    tabindex="-1"
    class="relative z-10 grid min-h-0 flex-1 grid-rows-[auto_minmax(0,1fr)] gap-4 px-4 py-4 sm:px-7 sm:py-6 lg:grid-cols-[minmax(19rem,0.82fr)_minmax(28rem,1.18fr)] lg:grid-rows-1 lg:items-stretch lg:gap-9 lg:px-10 lg:py-8 xl:gap-14"
  >
    <section class="flex min-w-0 flex-col justify-center lg:pb-4">
      <h1
        class:list={[
          "display-type max-w-full break-words text-[clamp(2.3rem,8.2vw,5.2rem)] uppercase leading-[0.92] tracking-[-0.018em] text-foreground [hyphens:auto] [text-wrap:pretty]",
          needsCompactHero
            ? "lg:text-[clamp(3rem,4.5vw,4.8rem)]"
            : "lg:text-[clamp(4.1rem,6.15vw,6.4rem)]",
        ]}
      >
        {heroCopy.before}{heroCopy.brand && <span class="[hyphens:none]">{heroCopy.brand}</span>}{heroCopy.after}
      </h1>

      <nav class="mt-4 flex flex-wrap gap-2 sm:mt-5 sm:gap-3 lg:mt-8" aria-label={t.nav.menu}>
        <a
          href={localizePath("/tour-dates", lang)}
          class="group inline-flex min-h-12 items-center gap-4 border border-primary bg-primary px-5 text-sm font-black uppercase tracking-[0.13em] text-primary-foreground shadow-[0.3rem_0.3rem_0_var(--signal-blue)] transition-transform hover:-translate-y-0.5 sm:px-6"
        >
          {t.nav.tour}
          <ArrowRight className="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
        <button
          type="button"
          data-menu-open-secondary
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="site-menu"
          class="inline-flex min-h-12 cursor-pointer items-center gap-3 border border-foreground bg-transparent px-5 text-sm font-black uppercase tracking-[0.13em] transition-colors hover:bg-foreground hover:text-background sm:px-6"
        >
          <Menu className="size-4" aria-hidden="true" />
          {t.nav.menu}
        </button>
      </nav>
    </section>

    <figure class="print-shadow relative min-h-0 overflow-hidden border-2 border-foreground bg-[#090806]">
      <div class="absolute inset-0">
        <HomeAnimation client:load />
      </div>
      <figcaption class="pointer-events-none absolute bottom-3 right-3 z-10 sm:bottom-4 sm:right-4">
        <span class="block border border-accent/50 bg-black/55 px-2 py-1 text-right text-[0.42rem] font-bold uppercase leading-none tracking-[0.07em] text-accent/85 backdrop-blur-sm sm:text-[0.46rem]">
          {t.hero.artworkCredit}
        </span>
      </figcaption>
    </figure>
  </main>

  <div class="relative z-20 flex min-h-8 items-center justify-between gap-4 border-t border-foreground/20 bg-background px-4 text-[0.55rem] font-bold uppercase tracking-[0.13em] text-muted-foreground sm:px-7 lg:px-10">
    <span>{t.hero.badges[4]}</span>
    <span class="hidden text-signal-blue sm:inline">{t.hero.badges[1]}</span>
    <span>{t.hero.badges[5]}</span>
  </div>
</div>

<dialog
  id="site-menu"
  data-menu
  class="m-0 h-dvh max-h-none w-full max-w-none border-0 bg-foreground p-0 text-background"
  aria-label={t.nav.menu}
>
  <div class="hairline-grid flex h-full flex-col overflow-hidden">
    <header class="flex min-h-[4.75rem] items-center justify-between border-b border-background/20 px-4 sm:px-7 lg:px-10">
      <div class="flex items-center gap-3">
        <img
          src="/million-words-logo-icon.webp"
          alt=""
          class="size-11 border border-background/25 bg-white object-cover"
          width="88"
          height="88"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="display-type text-lg uppercase leading-none">{t.meta.shortName}</p>
          <p class="mt-1 hidden text-[0.58rem] font-bold uppercase tracking-[0.15em] text-background/55 sm:block">
            {t.meta.tagline}
          </p>
        </div>
      </div>
      <button
        type="button"
        data-menu-close
        class="flex min-h-11 cursor-pointer items-center gap-2 border border-background/40 px-3 text-xs font-bold uppercase tracking-[0.12em] transition-colors hover:border-primary hover:bg-primary sm:px-4"
      >
        {t.common.close}
        <X className="size-4" aria-hidden="true" />
      </button>
    </header>

    <div class="grid min-h-0 flex-1 lg:grid-cols-[0.38fr_0.62fr]">
      <div class="hidden border-r border-background/20 p-10 lg:flex lg:flex-col lg:justify-between">
        <p class="eyebrow text-primary-bright">{t.nav.menu}</p>
        <p class="display-type max-w-xs text-5xl uppercase leading-[0.9] text-background/20">
          {t.hero.title}
        </p>
        <p class="max-w-xs text-sm leading-6 text-background/55">{t.hero.subtitle}</p>
      </div>

      <nav class="min-h-0 overflow-y-auto px-4 py-3 sm:px-7 lg:px-10 lg:py-6" aria-label={t.nav.menu}>
        {
          footerNav.map((link, index) => (
            <a
              href={localizePath(link.href, lang)}
              class="group flex min-h-14 items-center gap-4 border-b border-background/18 py-2.5 transition-colors hover:border-primary-bright hover:text-primary-bright sm:min-h-16"
            >
              <span class="w-7 text-[0.62rem] font-bold tabular-nums text-background/40">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="display-type flex-1 text-[clamp(1.7rem,6vh,3.8rem)] uppercase leading-none">
                {navLabel(link.key)}
              </span>
              <ArrowUpRight className="size-5 opacity-40 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:opacity-100" aria-hidden="true" />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</dialog>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-menu]");
    const openButtons = [...document.querySelectorAll("[data-menu-open], [data-menu-open-secondary]")];
    const closeButton = document.querySelector("[data-menu-close]");
    let activeTrigger = null;

    if (!(dialog instanceof HTMLDialogElement) || openButtons.length === 0) return;

    const open = (trigger) => {
      activeTrigger = trigger;
      dialog.showModal();
      openButtons.forEach((button) => button.setAttribute("aria-expanded", "true"));
      document.body.classList.add("home-menu-open");
    };

    openButtons.forEach((button) => button.addEventListener("click", () => open(button)));
    closeButton?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      openButtons.forEach((button) => button.setAttribute("aria-expanded", "false"));
      document.body.classList.remove("home-menu-open");
      activeTrigger?.focus();
    });
  })();
</script>
