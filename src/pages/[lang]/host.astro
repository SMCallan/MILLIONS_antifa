---
import HostBody from "@/components/pages/Host.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getLocalePaths, useTranslations } from "@/i18n";

export const getStaticPaths = getLocalePaths;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.nav.host} description={t.host.heroSubtitle}>
  <HostBody />
</Layout>
