---
import { footerNav } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navLabel = (key: string) => (t.nav as Record<string, string>)[key] ?? key;
const year = new Date().getFullYear();
---

<footer class="hairline-grid border-t-4 border-primary bg-foreground text-background">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[0.9fr_1.1fr] md:py-16 lg:gap-20">
    <div>
      <div class="flex items-start gap-4">
        <img
          src="/million-words-logo-icon.webp"
          alt=""
          class="size-20 shrink-0 border border-background/20 bg-white object-cover sm:size-24"
          width="192"
          height="192"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="display-type max-w-sm text-3xl uppercase leading-[0.94] sm:text-4xl">{t.meta.siteName}</p>
          <p class="mt-3 text-[0.65rem] font-bold uppercase tracking-[0.15em] text-background/55">
            {t.meta.tagline}
          </p>
        </div>
      </div>
      <p class="mt-7 max-w-xl text-sm leading-7 text-background/65">{t.footer.tagline}</p>
    </div>

    <nav class="grid grid-cols-2 gap-x-7" aria-label={t.footer.navTitle}>
      {
        footerNav.map((link, index) => (
          <a
            href={localizePath(link.href, lang)}
            class="group flex min-h-12 items-center gap-2 border-b border-background/18 py-2 text-sm font-bold transition-colors hover:border-primary-bright hover:text-primary-bright"
          >
            <span class="flex-1">{navLabel(link.key)}</span>
            <span class="text-[0.58rem] tabular-nums text-background/35">
              {String(index + 1).padStart(2, "0")}
            </span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-background/18">
    <div class="container-page flex flex-col gap-3 py-5 text-[0.62rem] font-bold uppercase tracking-[0.12em] text-background/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {t.meta.siteName}</p>
      {/* Maker's credit in askcal.co.uk's own brand colours, matching its other
          sites. The brand stays lower case; 2026 is the year the site was made. */}
      <p class="normal-case tracking-normal text-[0.72rem] font-medium text-background/60">
        {t.footer.siteCreatedBy}{" "}
        <a
          href="https://www.askcal.co.uk/"
          target="_blank"
          rel="noopener"
          class="inline-block bg-[#f4fa63] px-1.5 py-0.5 font-bold text-[#2848dd] transition-colors hover:text-[#131b34] focus-visible:outline-[#2848dd]"
        >askcal.co.uk</a>{" "}· 2026
      </p>
    </div>
  </div>
</footer>
