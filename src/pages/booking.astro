---
import { CalendarDays, Send } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import TurnstileWidget from "@/components/TurnstileWidget.astro";
import { bookingFeatures } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const selectClass =
  "border-foreground/30 focus-visible:border-ring focus-visible:ring-ring/50 dark:bg-input/30 h-12 w-full rounded-sm border bg-card px-3.5 text-sm outline-none focus-visible:ring-[3px]";
---

<Layout
  title="Host the Exhibition"
  description="Enquire about hosting A Million Words Against Fascism at a venue, school, union, festival, or civic space."
>
  <SignalFieldHero
    client:load
    compact
    headline="Host A Million Words Against Fascism."
    subtitle="Share the basics about your venue, audience, education partners, and preferred dates. The tour can adapt the Solidarity Room, street-facing postcard activity, local history, and live programme to each setting."
    primaryCta={{ label: "Start enquiry", href: "#booking-form" }}
    secondaryCta={{ label: "Tour dates", href: "/tour-dates" }}
    badges={["Solidarity Room", "Schools and colleges", "Unions", "Arts venues", "Local history", "Poetry and music"]}
    statusLines={[
      "Most events are envisaged as long weekends with Friday school and college involvement",
      "Saturday programmes can include active participation from musicians, poets, artists, and community groups",
    ]}
  />

  <section id="booking-form" class="section-y bg-background">
    <div class="container-page grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <aside class="space-y-5">
        <h2 class="text-2xl font-black">Hosting formats</h2>
        <div class="grid gap-4">
          {
            bookingFeatures.map((item) => (
              <p class="border-l-4 border-secondary pl-4 text-sm leading-7 text-muted-foreground">{item}</p>
            ))
          }
        </div>
        <div class="rounded-lg border bg-muted/45 p-5">
          <p class="flex items-center gap-2 text-sm font-semibold">
            <CalendarDays className="size-4" aria-hidden="true" />
            Typical lead time
          </p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">
            Event lengths will vary by venue, but most stops are envisaged as long weekends with
            school or college participation on Friday and wider public activity on Saturday.
          </p>
        </div>
      </aside>

      <Card>
        <CardHeader>
          <CardTitle className="text-2xl">Host enquiry form</CardTitle>
          <CardDescription>
            Tell us about the venue, audience, education links, local history, and dates you are
            considering.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div data-form-status="success" hidden class="mb-6 rounded-md border border-secondary bg-secondary/35 p-4 text-sm font-medium text-secondary-foreground" role="status">
            Host enquiry received. The details have been saved for follow-up.
          </div>
          <div data-form-status="storage" hidden class="mb-6 rounded-md border border-accent bg-accent/25 p-4 text-sm font-medium text-accent-foreground" role="status">
            The host enquiry was valid, but it was not stored because the Cloudflare R2 storage binding is not configured yet.
          </div>
          <div data-form-status="missing" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please complete the required fields before submitting.
          </div>
          <div data-form-status="invalid-email" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please enter a valid email address.
          </div>
          <div data-form-status="too-long" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            One or more answers is too long. Please shorten it and submit again.
          </div>
          <div data-form-status="storage-error" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            The enquiry could not be saved. Please try again later.
          </div>
          <div data-form-status="invalid" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            The enquiry could not be read. Please check the form and try again.
          </div>
          <div data-form-status="turnstile-missing" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please complete the verification challenge before submitting.
          </div>
          <div data-form-status="turnstile-invalid" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification failed. Please complete the challenge and try again.
          </div>
          <div data-form-status="turnstile-unconfigured" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification is not configured for this environment.
          </div>
          <div data-form-status="turnstile-unavailable" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Verification could not be completed. Please try again.
          </div>

          <script is:inline>
            const params = new URLSearchParams(window.location.search);
            const status = params.get("storage") === "unconfigured"
              ? "storage"
              : params.get("submitted") === "1"
                ? "success"
                : params.get("error");

            if (status && /^[a-z-]+$/.test(status)) {
              document.querySelector(`[data-form-status="${status}"]`)?.removeAttribute("hidden");
            }
          </script>

          <form action="/api/booking" method="post" class="grid gap-6">
            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="organisation">Organisation or centre *</Label>
                <Input id="organisation" name="organisation" required autoComplete="organization" maxLength={120} />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="contactName">Contact name *</Label>
                <Input id="contactName" name="contactName" required autoComplete="name" maxLength={120} />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="email">Email *</Label>
                <Input id="email" name="email" type="email" required autoComplete="email" maxLength={254} />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="phone">Phone</Label>
                <Input id="phone" name="phone" type="tel" autoComplete="tel" maxLength={80} />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="location">Venue location</Label>
                <Input id="location" name="location" autoComplete="address-level2" maxLength={120} />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="venueType">Venue type</Label>
                <select id="venueType" name="venueType" class={selectClass}>
                  <option value="">Select venue type</option>
                  <option>Community centre</option>
                  <option>Gallery or museum</option>
                  <option>Library</option>
                  <option>School, college, or university</option>
                  <option>Union or workplace venue</option>
                  <option>Festival or temporary space</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="dateRange">Preferred date range</Label>
                <Input id="dateRange" name="dateRange" placeholder="e.g. September 2026" maxLength={120} />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="expectedAudience">Expected audience</Label>
                <Input id="expectedAudience" name="expectedAudience" placeholder="e.g. 150 visitors" maxLength={80} />
              </div>
            </div>

            <div class="grid gap-2">
              <Label htmlFor="spaceDetails">Space and access details</Label>
              <Textarea
                id="spaceDetails"
                name="spaceDetails"
                rows={4}
                maxLength={2000}
                placeholder="Room size, wall length, street-facing areas, public opening times, school access, equipment, or access needs."
              />
            </div>

            <div class="grid gap-2">
              <Label htmlFor="message">Enquiry details *</Label>
              <Textarea
                id="message"
                name="message"
                required
                rows={6}
                maxLength={3000}
                placeholder="Tell us what you would like to host, any local International Brigades history, programme ideas, and what support you need."
              />
            </div>

            <TurnstileWidget />

            <Button type="submit" size="lg" className="w-full sm:w-fit">
              <Send aria-hidden="true" />
              Send host enquiry
            </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>
