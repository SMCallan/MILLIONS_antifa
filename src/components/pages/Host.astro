---
import { ArrowRight, CalendarDays, Send } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.host.heroTitle}
  subtitle={t.host.heroSubtitle}
  primaryCta={{ label: t.host.heroPrimaryCta, href: "#enquiry" }}
  secondaryCta={{ label: t.host.heroSecondaryCta, href: localizePath("/tour-dates", lang) }}
  badges={t.hero.badges}
  statusLines={t.hero.statusLines}
/>

<section class="section-y bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-start">
    <div>
      <Badge variant="secondary">{t.nav.host}</Badge>
      <h2 class="mt-4 text-3xl font-black leading-tight md:text-4xl">{t.hostConditions.heroTitle}</h2>
      <p class="mt-5 max-w-2xl text-base leading-8 text-muted-foreground">{t.hostConditions.intro}</p>

      <div class="mt-8 grid gap-6">
        {
          t.hostConditions.sections.map((section) => (
            <article class="border-l-4 border-secondary pl-5">
              <h3 class="text-lg font-black">{section.heading}</h3>
              <p class="mt-2 text-sm leading-7 text-muted-foreground">{section.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <aside id="enquiry" class="grid gap-6 lg:sticky lg:top-28">
      <Card>
        <CardHeader>
          <CardTitle className="text-2xl">{t.hostConditions.ctaTitle}</CardTitle>
        </CardHeader>
        <CardContent className="grid gap-4">
          <p class="text-sm leading-7 text-muted-foreground">{t.hostConditions.ctaBody}</p>
          <a class={buttonVariants({ size: "lg", className: "w-full" })} href="/booking">
            <Send className="size-4" aria-hidden="true" />
            {t.hostConditions.ctaButton}
          </a>
          <a
            class={buttonVariants({ variant: "outline", className: "w-full" })}
            href={localizePath("/tour-dates", lang)}
          >
            {t.host.heroSecondaryCta}
            <ArrowRight className="size-4" aria-hidden="true" />
          </a>
        </CardContent>
      </Card>

      <div class="rounded-lg border bg-muted/45 p-5">
        <p class="flex items-center gap-2 text-sm font-semibold">
          <CalendarDays className="size-4" aria-hidden="true" />
          {t.host.leadTimeTitle}
        </p>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">{t.host.leadTimeBody}</p>
      </div>
    </aside>
  </div>
</section>
