---
import { ArrowRight } from "lucide-react";

import { buttonVariants } from "@/components/ui/button";
import { moreInfoNav, primaryNav } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navLabel = (key: string) => (t.nav as Record<string, string>)[key] ?? key;

// Everything except Donate, which leaves the site entirely — an off-site link
// is a poor way to recover from a wrong turn.
const suggestions = [...primaryNav, ...moreInfoNav].filter((link) => link.key !== "donate");
---

<section class="section-y bg-background">
  <div class="container-page max-w-3xl">
    <p class="eyebrow text-signal-blue">404</p>
    <h1 class="display-type mt-3 text-[clamp(2.5rem,7vw,4.5rem)] uppercase leading-[0.95] tracking-[-0.02em]">
      {t.notFound.title}
    </h1>
    <p class="mt-5 text-base leading-8 text-muted-foreground">{t.notFound.body}</p>

    <a class={buttonVariants({ size: "lg", className: "mt-8" })} href={localizePath("/", lang)}>
      {t.common.backToHome}
      <ArrowRight className="size-4" aria-hidden="true" />
    </a>

    <nav class="mt-10 border-t border-foreground/15 pt-6" aria-label={t.nav.menu}>
      <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {
          suggestions.map((link) => (
            <li>
              <a
                href={localizePath(link.href, lang)}
                class="inline-flex py-1 text-sm font-bold uppercase tracking-[0.1em] text-muted-foreground transition-colors hover:text-primary"
              >
                {navLabel(link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
