---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import {
  defaultLang,
  getLangFromUrl,
  getLogicalPath,
  isLocalizedPath,
  languageCodes,
  localizePath,
  useTranslations,
} from "@/i18n";
import { languages } from "@/i18n/languages";
import "@/styles/global.css";
// Hashed build URL for the Latin subset, preloaded below. The display type is
// the largest thing above the fold, so waiting on the stylesheet to discover
// this file is a visible swap.
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  /**
   * Single-screen mode (home page): no site header/footer chrome and no body
   * scrolling — the page composes its own full-viewport layout.
   */
  minimal?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { dir } = languages[lang];

const {
  title = t.meta.siteName,
  description = t.meta.description,
  minimal = false,
} = Astro.props;

const pageTitle = title === t.meta.siteName ? title : `${title} | ${t.meta.siteName}`;

// Canonical + hreflang alternates. Alternates are only emitted for pages that
// actually have localized mirrors; the English-only functional pages get a
// self-canonical without alternates.
const logicalPath = getLogicalPath(Astro.url.pathname);
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonicalHref = abs(localizePath(logicalPath, lang));
const alternates = isLocalizedPath(Astro.url.pathname)
  ? languageCodes.map((code) => ({ code, href: abs(localizePath(logicalPath, code)) }))
  : [];
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang} />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={abs(localizePath(logicalPath, defaultLang))} />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body class:list={[minimal && "overflow-hidden"]}>
    <a class="skip-link" href="#main-content">{t.common.skipToContent}</a>
    <div class="prototype-ribbon">Prototype site</div>
    {
      minimal ? (
        <slot />
      ) : (
        <>
          <SiteHeader />
          <main id="main-content" tabindex="-1">
            <slot />
          </main>
          <SiteFooter />
        </>
      )
    }
  </body>
</html>
