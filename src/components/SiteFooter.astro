---
import { navLinks, site } from "@/data/site";
---

<footer class="border-t bg-foreground text-background">
  <div class="container-page grid gap-8 py-10 md:grid-cols-[1fr_auto]">
    <div class="max-w-2xl">
      <p class="text-lg font-semibold">{site.name}</p>
      <p class="mt-3 text-sm leading-6 text-background/75">{site.description}</p>
      <p class="mt-4 text-xs text-background/60">Hero image: {site.heroCredit}.</p>
    </div>

    <nav class="flex flex-col gap-2 text-sm" aria-label="Footer navigation">
      {navLinks.map((link) => <a href={link.href} class="text-background/75 hover:text-background">{link.label}</a>)}
    </nav>
  </div>
</footer>
