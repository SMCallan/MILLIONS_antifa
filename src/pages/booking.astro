---
import { CalendarDays, Send } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { bookingFeatures } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const selectClass =
  "border-input focus-visible:border-ring focus-visible:ring-ring/50 dark:bg-input/30 h-10 w-full rounded-md border bg-transparent px-3 text-sm shadow-xs outline-none focus-visible:ring-[3px]";
---

<Layout
  title="Book the Exhibition"
  description="Enquire about booking the Anti-Fascist Art Exhibition for your centre, venue, or local programme."
>
  <SignalFieldHero
    client:load
    compact
    headline="Host the exhibition at your centre or location."
    subtitle="Share the basics about your venue, audience, and preferred dates. The booking team can scope the right format for the anti-fascist exhibition, from compact displays to larger public programmes."
    primaryCta={{ label: "Start enquiry", href: "#booking-form" }}
    secondaryCta={{ label: "Tour dates", href: "/tour-dates" }}
    badges={["Booking enquiries", "Community centres", "Galleries", "Libraries", "Schools", "Unions", "Flexible formats"]}
    statusLines={[
      "World tour hosts are now being mapped",
      "The exhibition can scale for one-day pop-ups, week-long displays, or longer touring blocks",
    ]}
  />

  <section id="booking-form" class="section-y bg-background">
    <div class="container-page grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <aside class="space-y-5">
        <h2 class="text-2xl font-black">Booking formats</h2>
        <div class="grid gap-4">
          {
            bookingFeatures.map((item) => (
              <p class="border-l-4 border-secondary pl-4 text-sm leading-7 text-muted-foreground">{item}</p>
            ))
          }
        </div>
        <div class="rounded-lg border bg-muted/45 p-5">
          <p class="flex items-center gap-2 text-sm font-semibold">
            <CalendarDays className="size-4" aria-hidden="true" />
            Typical lead time
          </p>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">
            Allow four to eight weeks for routing, access planning, shipping, insurance, and public
            programme coordination.
          </p>
        </div>
      </aside>

      <Card>
        <CardHeader>
          <CardTitle className="text-2xl">Booking enquiry form</CardTitle>
          <CardDescription>
            Tell us about the venue, audience, and dates you are considering.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <div data-form-status="success" hidden class="mb-6 rounded-md border border-secondary bg-secondary/35 p-4 text-sm font-medium text-secondary-foreground" role="status">
            Booking enquiry received. The details have been saved for follow-up.
          </div>
          <div data-form-status="storage" hidden class="mb-6 rounded-md border border-accent bg-accent/25 p-4 text-sm font-medium text-accent-foreground" role="status">
            Booking enquiry received in preview mode, but the Cloudflare R2 storage binding is not configured yet.
          </div>
          <div data-form-status="missing" hidden class="mb-6 rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive" role="alert">
            Please complete the required fields before submitting.
          </div>

          <script is:inline>
            const params = new URLSearchParams(window.location.search);
            const status = params.get("storage") === "unconfigured"
              ? "storage"
              : params.get("submitted") === "1"
                ? "success"
                : params.get("error");

            if (status) {
              document.querySelector(`[data-form-status="${status}"]`)?.removeAttribute("hidden");
            }
          </script>

          <form action="/api/booking" method="post" class="grid gap-6">
            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="organisation">Organisation or centre *</Label>
                <Input id="organisation" name="organisation" required autoComplete="organization" />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="contactName">Contact name *</Label>
                <Input id="contactName" name="contactName" required autoComplete="name" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="email">Email *</Label>
                <Input id="email" name="email" type="email" required autoComplete="email" />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="phone">Phone</Label>
                <Input id="phone" name="phone" type="tel" autoComplete="tel" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="location">Venue location</Label>
                <Input id="location" name="location" autoComplete="address-level2" />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="venueType">Venue type</Label>
                <select id="venueType" name="venueType" class={selectClass}>
                  <option value="">Select venue type</option>
                  <option>Community centre</option>
                  <option>Gallery or museum</option>
                  <option>Library</option>
                  <option>School, college, or university</option>
                  <option>Union or workplace venue</option>
                  <option>Festival or temporary space</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="grid gap-2">
                <Label htmlFor="dateRange">Preferred date range</Label>
                <Input id="dateRange" name="dateRange" placeholder="e.g. September 2026" />
              </div>
              <div class="grid gap-2">
                <Label htmlFor="expectedAudience">Expected audience</Label>
                <Input id="expectedAudience" name="expectedAudience" placeholder="e.g. 150 visitors" />
              </div>
            </div>

            <div class="grid gap-2">
              <Label htmlFor="spaceDetails">Space and access details</Label>
              <Textarea
                id="spaceDetails"
                name="spaceDetails"
                rows={4}
                placeholder="Wall length, room access, invigilation, public opening times, equipment, or access needs."
              />
            </div>

            <div class="grid gap-2">
              <Label htmlFor="message">Enquiry details *</Label>
              <Textarea
                id="message"
                name="message"
                required
                rows={6}
                placeholder="Tell us what you would like to host and what support you need."
              />
            </div>

            <Button type="submit" size="lg" className="w-full sm:w-fit">
              <Send aria-hidden="true" />
              Send booking enquiry
            </Button>
          </form>
        </CardContent>
      </Card>
    </div>
  </section>
</Layout>
