---
import ConceptBody from "@/components/pages/Concept.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getLocalePaths, useTranslations } from "@/i18n";

export const getStaticPaths = getLocalePaths;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.nav.concept} description={t.concept.heroSubtitle}>
  <ConceptBody />
</Layout>
