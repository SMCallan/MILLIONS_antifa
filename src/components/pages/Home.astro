---
import { HomeAnimation } from "@/components/HomeAnimation";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { footerNav } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const navLabel = (key: string) => (t.nav as Record<string, string>)[key] ?? key;
---

<!--
  Single-screen home page (client direction, July 2026): the whole page fits
  the viewport with no scrolling on any device. Logo top-left, language flags,
  title beside the animation panel, and two actions: MENU (opens the site menu
  overlay) and TOUR (straight to the tour page).
-->
<div class="flex h-dvh flex-col overflow-hidden bg-background text-foreground">
  <header class="flex items-center justify-between gap-4 px-4 pt-3 sm:px-6">
    <a href={localizePath("/", lang)} class="shrink-0" aria-label={t.meta.siteName}>
      <img
        src="/million-words-logo.png"
        alt={t.meta.siteName}
        class="size-14 rounded-md border bg-white object-contain p-1 shadow-sm sm:size-16"
        loading="eager"
        decoding="async"
      />
    </a>
    <LanguageSwitcher />
  </header>

  <main
    class="flex min-h-0 flex-1 flex-col gap-5 px-4 py-4 sm:px-6 lg:grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-12 lg:px-12 lg:py-8"
  >
    <div class="flex flex-col gap-6 lg:gap-10">
      <h1 class="max-w-xl text-[clamp(2.25rem,5.5vw,4.75rem)] font-black leading-[1.04] tracking-tight">
        {t.hero.title}
      </h1>

      <nav class="flex flex-wrap gap-3 lg:flex-col lg:items-start lg:gap-4" aria-label={t.nav.menu}>
        <button
          type="button"
          data-menu-open
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="site-menu"
          class="inline-flex cursor-pointer items-center rounded-md bg-foreground px-7 py-3.5 text-xl font-black uppercase tracking-widest text-background transition-colors hover:bg-primary hover:text-primary-foreground sm:px-9 sm:py-4 sm:text-2xl"
        >
          {t.nav.menu}
        </button>
        <a
          href={localizePath("/tour-dates", lang)}
          class="inline-flex items-center rounded-md bg-primary px-7 py-3.5 text-xl font-black uppercase tracking-widest text-primary-foreground transition-colors hover:bg-foreground hover:text-background sm:px-9 sm:py-4 sm:text-2xl"
        >
          {t.nav.tour}
        </a>
      </nav>
    </div>

    <!-- Animation panel: placeholder shader until the commissioned loop is supplied. -->
    <div
      class="relative min-h-28 flex-1 overflow-hidden rounded-2xl border border-border/70 bg-[#0b0a09] shadow-xl lg:flex-none lg:self-stretch"
    >
      <HomeAnimation client:load />
    </div>
  </main>
</div>

<!-- Full-screen site menu -->
<div
  id="site-menu"
  data-menu
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-background/98 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label={t.nav.menu}
>
  <div class="flex items-center justify-between px-4 py-3 sm:px-6">
    <img
      src="/million-words-logo.png"
      alt=""
      class="size-12 rounded-md border bg-white object-contain p-1"
      loading="lazy"
      decoding="async"
    />
    <button
      type="button"
      data-menu-close
      class="cursor-pointer rounded-md border px-4 py-2 text-sm font-bold uppercase tracking-wide transition-colors hover:bg-accent hover:text-accent-foreground"
    >
      {t.common.close}
    </button>
  </div>

  <nav
    class="flex min-h-0 flex-1 flex-col items-center justify-center gap-1 overflow-y-auto px-6 py-4"
    aria-label={t.nav.menu}
  >
    {
      footerNav.map((link) => (
        <a
          href={localizePath(link.href, lang)}
          class="rounded-md px-6 py-2 text-[clamp(1.5rem,4vh,2.4rem)] font-black tracking-tight transition-colors hover:text-primary"
        >
          {navLabel(link.key)}
        </a>
      ))
    }
  </nav>
</div>

<script is:inline>
  // Menu overlay toggle. Progressive enhancement only — every menu destination
  // is also reachable from the other pages' standard header.
  (() => {
    const menu = document.querySelector("[data-menu]");
    const openButton = document.querySelector("[data-menu-open]");
    const closeButton = document.querySelector("[data-menu-close]");
    if (!menu || !openButton) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      openButton.setAttribute("aria-expanded", String(open));
      (open ? closeButton : openButton)?.focus();
    };

    openButton.addEventListener("click", () => setOpen(true));
    closeButton?.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) setOpen(false);
    });
  })();
</script>
