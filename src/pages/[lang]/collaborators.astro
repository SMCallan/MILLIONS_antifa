---
import CollaboratorsBody from "@/components/pages/Collaborators.astro";
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, getLocalePaths, useTranslations } from "@/i18n";

export const getStaticPaths = getLocalePaths;

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout title={t.nav.collaborators} description={t.collaborators.heroSubtitle}>
  <CollaboratorsBody />
</Layout>
