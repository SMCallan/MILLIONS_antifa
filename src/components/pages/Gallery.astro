---
import { Upload } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { buttonVariants } from "@/components/ui/button";
import { galleryImages } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Placeholder images until confirmed works replace them. They come in mixed
// shapes, so they sit in columns at their own proportions rather than being
// cropped into equal tiles.
const srcset = ({ key, width }: (typeof galleryImages)[number]) =>
  `/gallery/${key}-800.webp 800w, /gallery/${key}-${width}.webp ${width}w`;
---

<SignalFieldHero
  client:load
  compact
  headline={t.gallery.heroTitle}
  subtitle={t.gallery.heroSubtitle}
  primaryCta={{ label: t.gallery.contributeCta, href: localizePath("/contribute", lang) }}
  secondaryCta={{ label: t.hero.primaryCta, href: localizePath("/tour-dates", lang) }}
/>

<section class="section-y bg-background">
  <div class="container-page">
    <div class="mb-10 max-w-2xl">
      <h2 class="text-3xl font-black leading-tight md:text-4xl">{t.gallery.placeholderTitle}</h2>
      <p class="mt-4 text-base leading-8 text-muted-foreground">{t.gallery.placeholderBody}</p>
    </div>

    <ul class="gap-5 sm:columns-2 lg:columns-3">
      {
        galleryImages.map((image) => (
          <li class="mb-5 break-inside-avoid border-2 border-foreground bg-foreground shadow-[0.3rem_0.3rem_0_var(--foreground)]">
            <img
              src={`/gallery/${image.key}-800.webp`}
              srcset={srcset(image)}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              width={image.width}
              height={image.height}
              alt={t.gallery.images[image.key] ?? ""}
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <a class={buttonVariants({ size: "lg" })} href={localizePath("/contribute", lang)}>
        <Upload className="size-4" aria-hidden="true" />
        {t.gallery.contributeCta}
      </a>
    </div>
  </div>
</section>
