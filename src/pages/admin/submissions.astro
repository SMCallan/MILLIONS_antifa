---
import { RefreshCw, ShieldCheck } from "lucide-react";

import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";

const reviewStatuses = ["new", "reviewed", "shortlisted", "rejected", "contacted"];
---

<Layout
  title="Submission Review"
  description="Protected reviewer interface for artwork submission metadata."
>
  <section class="section-y bg-background">
    <div class="container-page max-w-7xl space-y-6">
      <div class="flex flex-col gap-4 border-b pb-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-3xl space-y-3">
          <p class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-widest text-primary">
            <ShieldCheck aria-hidden="true" className="size-4" />
            Protected review
          </p>
          <h1 class="text-3xl font-black sm:text-4xl">Artwork submissions</h1>
          <p class="text-sm leading-6 text-muted-foreground">
            This admin route and its `/admin/api/*` endpoints must be protected with
            Cloudflare Access before production use. Private R2 preview objects are not linked here.
          </p>
        </div>
        <Button type="button" variant="outline" data-refresh>
          <RefreshCw aria-hidden="true" />
          Refresh
        </Button>
      </div>

      <div
        data-admin-status
        class="rounded-md border bg-muted/40 p-4 text-sm font-medium text-muted-foreground"
        role="status"
      >
        Loading submissions...
      </div>

      <div data-empty-state hidden class="rounded-md border bg-muted/35 p-6 text-sm text-muted-foreground">
        No submitted artwork metadata is available yet.
      </div>

      <div data-table-wrap hidden class="overflow-x-auto rounded-md border bg-background">
        <table class="w-full min-w-[1080px] text-left text-sm">
          <thead class="border-b bg-muted/45 text-xs uppercase tracking-wide text-muted-foreground">
            <tr>
              <th scope="col" class="px-4 py-3">Title</th>
              <th scope="col" class="px-4 py-3">Email</th>
              <th scope="col" class="px-4 py-3">Portfolio</th>
              <th scope="col" class="px-4 py-3">Preview</th>
              <th scope="col" class="px-4 py-3">Files</th>
              <th scope="col" class="px-4 py-3">Total size</th>
              <th scope="col" class="px-4 py-3">Status</th>
              <th scope="col" class="px-4 py-3">Submitted</th>
              <th scope="col" class="px-4 py-3">Updated</th>
            </tr>
          </thead>
          <tbody data-submissions-body class="divide-y" />
        </table>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ reviewStatuses }}>
    const endpoint = "/admin/api/submissions";
    const statusEl = document.querySelector("[data-admin-status]");
    const tableWrap = document.querySelector("[data-table-wrap]");
    const emptyState = document.querySelector("[data-empty-state]");
    const bodyEl = document.querySelector("[data-submissions-body]");
    const refreshButton = document.querySelector("[data-refresh]");
    const statusLabels = {
      new: "New",
      reviewed: "Reviewed",
      shortlisted: "Shortlisted",
      rejected: "Rejected",
      contacted: "Contacted",
    };

    function setStatus(message, tone = "muted") {
      statusEl.hidden = false;
      statusEl.textContent = message;
      statusEl.className =
        tone === "error"
          ? "rounded-md border border-destructive bg-destructive/10 p-4 text-sm font-medium text-destructive"
          : "rounded-md border bg-muted/40 p-4 text-sm font-medium text-muted-foreground";
    }

    function hideStatus() {
      statusEl.hidden = true;
      statusEl.textContent = "";
    }

    function formatBytes(bytes) {
      const value = Number(bytes || 0);
      if (value < 1024) return `${value} B`;
      if (value < 1024 * 1024) return `${(value / 1024).toFixed(1)} KB`;
      return `${(value / (1024 * 1024)).toFixed(1)} MB`;
    }

    function formatDate(value) {
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return "";
      return new Intl.DateTimeFormat(undefined, {
        dateStyle: "medium",
        timeStyle: "short",
      }).format(date);
    }

    function appendTextCell(row, value) {
      const cell = document.createElement("td");
      cell.className = "max-w-[240px] px-4 py-3 align-top";
      const text = document.createElement("span");
      text.className = value ? "block truncate" : "text-muted-foreground";
      text.textContent = value || "None";
      cell.append(text);
      row.append(cell);
    }

    function appendLinkCell(row, value) {
      const cell = document.createElement("td");
      cell.className = "max-w-[220px] px-4 py-3 align-top";

      if (isHttpUrl(value)) {
        const link = document.createElement("a");
        link.href = value;
        link.target = "_blank";
        link.rel = "noreferrer";
        link.className = "block truncate font-medium text-primary underline-offset-4 hover:underline";
        link.textContent = value;
        cell.append(link);
      } else {
        const empty = document.createElement("span");
        empty.className = "text-muted-foreground";
        empty.textContent = "None";
        cell.append(empty);
      }

      row.append(cell);
    }

    function appendStatusCell(row, submission) {
      const cell = document.createElement("td");
      cell.className = "px-4 py-3 align-top";
      const select = document.createElement("select");
      select.className = "h-9 min-w-36 rounded-md border bg-background px-3 text-sm";
      select.setAttribute("aria-label", `Update status for ${submission.title || submission.email}`);

      for (const status of reviewStatuses) {
        const option = document.createElement("option");
        option.value = status;
        option.textContent = statusLabels[status] || status;
        option.selected = status === submission.status;
        select.append(option);
      }

      select.addEventListener("change", async () => {
        select.disabled = true;
        try {
          await updateStatus(submission.id, select.value);
          await loadSubmissions(false);
          setStatus("Status updated.");
          window.setTimeout(hideStatus, 1800);
        } catch (error) {
          setStatus(error.message || "Status could not be updated.", "error");
          select.value = submission.status;
        } finally {
          select.disabled = false;
        }
      });

      cell.append(select);
      row.append(cell);
    }

    function appendDateCell(row, value) {
      const cell = document.createElement("td");
      cell.className = "whitespace-nowrap px-4 py-3 align-top text-muted-foreground";
      cell.textContent = formatDate(value);
      row.append(cell);
    }

    function renderSubmissions(submissions) {
      bodyEl.replaceChildren();
      tableWrap.hidden = submissions.length === 0;
      emptyState.hidden = submissions.length !== 0;

      for (const submission of submissions) {
        const row = document.createElement("tr");
        row.className = "hover:bg-muted/25";
        appendTextCell(row, submission.title || "Untitled");
        appendTextCell(row, submission.email);
        appendLinkCell(row, submission.portfolioUrl);
        appendLinkCell(row, submission.previewLink);
        appendTextCell(row, String(submission.fileCount || 0));
        appendTextCell(row, formatBytes(submission.totalBytes));
        appendStatusCell(row, submission);
        appendDateCell(row, submission.submittedAt);
        appendDateCell(row, submission.updatedAt);
        bodyEl.append(row);
      }
    }

    async function loadSubmissions(showLoading = true) {
      if (showLoading) {
        setStatus("Loading submissions...");
      }
      refreshButton.disabled = true;

      try {
        const response = await fetch(endpoint, {
          credentials: "same-origin",
          headers: { Accept: "application/json" },
        });
        const payload = await response.json().catch(() => ({ ok: false, error: "invalid" }));
        if (!response.ok || !payload.ok) {
          throw new Error(errorMessage(payload.error));
        }
        renderSubmissions(payload.submissions || []);
        if (showLoading) {
          hideStatus();
        }
      } catch (error) {
        tableWrap.hidden = true;
        emptyState.hidden = true;
        setStatus(error.message || "Submissions could not be loaded.", "error");
      } finally {
        refreshButton.disabled = false;
      }
    }

    async function updateStatus(id, status) {
      const response = await fetch(endpoint, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ id, status }),
      });
      const payload = await response.json().catch(() => ({ ok: false, error: "invalid" }));
      if (!response.ok || !payload.ok) {
        throw new Error(errorMessage(payload.error));
      }
      return payload.submission;
    }

    function errorMessage(error) {
      const messages = {
        "database-error": "Submission metadata could not be read.",
        "database-unconfigured": "The SUBMISSIONS_DB binding is not configured.",
        invalid: "The status update was invalid.",
        "not-found": "The submission no longer exists.",
      };
      return messages[error] || "The admin request failed.";
    }

    function isHttpUrl(value) {
      try {
        const url = new URL(value);
        return url.protocol === "http:" || url.protocol === "https:";
      } catch {
        return false;
      }
    }

    refreshButton?.addEventListener("click", () => loadSubmissions());
    loadSubmissions();
  </script>
</Layout>
