---
import { ArrowRight, CalendarDays, MapPin } from "lucide-react";

import { SignalFieldHero } from "@/components/SignalFieldHero";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { tourDates } from "@/data/site";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SignalFieldHero
  client:load
  compact
  headline={t.tourDates.heroTitle}
  subtitle={t.tourDates.heroSubtitle}
  primaryCta={{ label: t.tourDates.heroPrimaryCta, href: "#route" }}
  secondaryCta={{ label: t.tourDates.heroSecondaryCta, href: localizePath("/host", lang) }}
/>

<section id="route" class="section-y bg-background">
  <div class="container-page">
    <div class="mb-10 max-w-3xl">
      <Badge>{t.tourDates.routeBadge}</Badge>
      <h2 class="mt-4 text-3xl font-black leading-tight md:text-5xl">{t.tourDates.routeTitle}</h2>
      <p class="mt-5 text-sm leading-7 text-muted-foreground">{t.tourDates.routeBody}</p>
    </div>

    <ol class="border-t-2 border-foreground">
      {
        tourDates.map((event, index) => (
          <li class="group grid gap-3 border-b border-foreground/25 py-5 transition-colors hover:bg-card sm:grid-cols-[4rem_7rem_1fr] sm:items-center sm:gap-5 sm:px-4 sm:py-6">
            <span class="display-type text-3xl tabular-nums text-muted-foreground/55 sm:text-4xl">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <p class="text-[0.6rem] font-extrabold uppercase tracking-[0.14em] text-muted-foreground">
                {t.tourDates.stop}
              </p>
              <p class="mt-1 inline-block bg-primary px-2 py-1 text-xs font-black uppercase tracking-[0.12em] text-primary-foreground">
                {t.tourDates.tbc}
              </p>
            </div>

            <div>
              <h3 class="display-type text-2xl uppercase leading-none transition-transform group-hover:translate-x-1 sm:text-3xl">
                {event.city}
              </h3>
              {event.venue && (
                <p class="mt-2 flex items-center gap-2 text-sm font-medium text-muted-foreground">
                  <MapPin className="size-4 text-primary" aria-hidden="true" />
                  {event.venue}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="bg-foreground py-16 text-background">
  <div class="container-page flex flex-col justify-between gap-6 md:flex-row md:items-center">
    <div>
      <p class="flex items-center gap-2 text-sm text-background/75">
        <CalendarDays className="size-4" aria-hidden="true" />
        {t.tourDates.ctaEyebrow}
      </p>
      <h2 class="mt-3 max-w-2xl text-3xl font-black leading-tight">{t.tourDates.ctaTitle}</h2>
    </div>
    <a class={buttonVariants({ variant: "secondary", size: "lg" })} href={localizePath("/host", lang)}>
      {t.tourDates.ctaButton}
      <ArrowRight className="size-4" aria-hidden="true" />
    </a>
  </div>
</section>
